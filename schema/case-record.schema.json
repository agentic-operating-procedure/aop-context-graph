{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-operating-procedure/aop-context-graph/schema/case-record.schema.json",
  "title": "Stitched Case Record",
  "description": "Schema for a stitched end-to-end case per the case schema document. The unit compilation consumes, provenance reaches back to, and the runtime case record is modelled on.",
  "type": "object",
  "required": [
    "case_id", "procedure", "started_at", "ended_at",
    "tasks", "actor_roles", "outcome",
    "provenance"
  ],
  "additionalProperties": true,
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "procedure": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "process_ref": {
      "type": "string",
      "pattern": "^processes:(process|activity)-[a-z0-9-]+$",
      "description": "DEA Business Process Catalog reference for the process this case is an occurrence of (CG-PA-1). Absent means a declared gap per CG-PA-5, carried in process_alignment_gap."
    },
    "process_alignment_gap": {
      "type": "string",
      "description": "Where no canonical catalog entry exists (CG-PA-5): the description of the gap to lodge as a contribution to dea-catalog-business-processes."
    },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "ended_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "process_ref": {
            "type": "string",
            "pattern": "^processes:(activity|task)-[a-z0-9-]+$",
            "description": "DEA catalog activity (or task) level reference for this task (CG-PA-1)."
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action", "application", "timestamp"],
              "additionalProperties": true,
              "properties": {
                "action": { "type": "string", "minLength": 1 },
                "application": { "type": "string", "minLength": 1 },
                "actor_role": { "type": "string", "description": "Role, never a person (CG-1). Absent means unattributed per CG-S6." },
                "unattributed": { "type": "boolean" },
                "handoff": { "type": "boolean" },
                "timestamp": { "type": "string", "minLength": 1 },
                "decisions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["branch_condition"],
                    "additionalProperties": true,
                    "properties": {
                      "branch_condition": { "type": "string", "minLength": 1 },
                      "evidence": { "type": "string" }
                    }
                  }
                },
                "exceptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["condition"],
                    "additionalProperties": true,
                    "properties": {
                      "condition": { "type": "string", "minLength": 1 },
                      "class": { "type": "string" },
                      "severity": { "enum": ["low", "moderate", "high", "critical"] },
                      "recoverability": { "type": "string" },
                      "escalation": {
                        "type": "object",
                        "required": ["target_role", "reason"],
                        "additionalProperties": true,
                        "properties": {
                          "target_role": { "type": "string", "minLength": 1 },
                          "reason": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "actor_roles": {
      "type": "array",
      "description": "Roles that participated. Persons do not appear (CG-1).",
      "items": { "type": "string", "minLength": 1 }
    },
    "incomplete_case": {
      "type": "object",
      "description": "Present when a handoff broke the case (CG-S11). Incomplete cases are retained and marked, not discarded (CG-S12).",
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "missing_from": { "type": "string" }
      }
    },
    "stitching_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Required for heuristically stitched cases (CG-S3)."
    },
    "outcome": {
      "type": "object",
      "required": ["result"],
      "additionalProperties": true,
      "properties": {
        "result": { "enum": ["achieved", "partially_achieved", "not_achieved", "achieved_with_deviation", "inconclusive"] },
        "cycle_time": { "type": "number" },
        "cost_per_case": { "type": "number" },
        "first_pass": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["stitching_version", "capture_surface_declaration_version"],
      "additionalProperties": true,
      "properties": {
        "stitching_version": { "type": "string", "minLength": 1 },
        "capture_surface_declaration_version": { "type": "string", "minLength": 1 },
        "process_catalog_version": {
          "type": "string",
          "description": "The DEA Business Process Catalog version the process references were resolved against (CG-PA-3)."
        },
        "source_events": { "type": "array", "items": { "type": "string" } },
        "correlation_key": { "type": "string", "description": "The domain correlation key where one exists (CG-S1)." }
      }
    }
  }
}
